<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store's sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Sync, catalogues, Discover, sign-ins and book details. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Grimoire receiving books, the sign-in page's way back, and Use on your phone at home. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Folders and books the person chooses, kept between restarts (folder_access.rs). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Books downloaded in Discover. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>TEAM_ID.com.krowsingre.theboundvigil</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAM_ID</string>
</dict>
</plist>
