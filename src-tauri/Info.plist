<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app's extra Info.plist lines (the iPhone's are in Info.ios.plist). -->
	<!-- Where the Mac App Store lists it. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.books</string>
	<!-- Only standard encryption (HTTPS), so App Store Connect doesn't ask each time. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Sending books to LocalSend on devices on the same Wi-Fi. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>The Bound Vigil sends books to devices on your Wi-Fi that have LocalSend open.</string>
	<!-- The Scribe book file (.tbv), TBV's own, so Finder names it (see Info.ios.plist). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.book</string>
			<key>UTTypeDescription</key>
			<string>Scribe book file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tbv</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.krowsingre.tbv+zip</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
