{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Bound Vigil",
  "version": "0.66.0",
  "identifier": "com.krowsingre.theboundvigil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "The Bound Vigil",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: https://www.googleapis.com https://openlibrary.org https://krowsingre.github.io; img-src 'self' asset: http://asset.localhost data: blob: https://books.google.com https://books.googleusercontent.com https://covers.openlibrary.org https://krowsingre.github.io https://*.archive.org https://m.media-amazon.com https://assets.hardcover.app; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:; media-src 'self' blob: tbvaudio: http://tbvaudio.localhost; frame-src 'self' blob:; child-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/**", "$APPDATA/Profile/**", "$APPDATA/Pictures/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "frameworks": ["Accelerate"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRTA5M0QwRTAwNEZCNUIKUldSYit3VGcwSlBnTG94UU1jaUR0cVorb0dRaWwvLytudDNpSXVYVVNhMzhMdDcrZWNIbm1VM0sK",
      "endpoints": ["https://github.com/Krowsingre/the-bound-vigil/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
