{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Bound Vigil",
  "version": "0.1.0",
  "identifier": "com.krowsingre.theboundvigil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Bound Vigil",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/**", "$APPDATA/Profile/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
