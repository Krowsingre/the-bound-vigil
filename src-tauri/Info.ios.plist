<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The name under the icon on the home screen. -->
	<key>CFBundleDisplayName</key>
	<string>Bound Vigil</string>
	<!-- Audiobooks and read aloud keep playing with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<!-- Syncing while TBV is closed, and lining up read-along carrying on while it's away (see BackgroundWork.swift). Silent pushes wake TBV to sync when another device has sent changes (Push.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.krowsingre.theboundvigil.lineup</string>
		<string>com.krowsingre.theboundvigil.sync</string>
	</array>
	<!-- Sending books to LocalSend on devices on the same Wi-Fi. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>The Bound Vigil sends books to devices on your Wi-Fi that have LocalSend open.</string>
	<!-- Only standard encryption (HTTPS), so TestFlight doesn't ask each time. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Books shared from other apps ("Open in", and TBV in the share sheet).
	     iOS hands over a copy, which TBV imports like any other book. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
				<string>org.idpf.epub-folder</string>
				<string>com.adobe.pdf</string>
				<string>public.plain-text</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>com.microsoft.word.doc</string>
				<string>public.mp3</string>
				<string>public.mpeg-4-audio</string>
				<string>public.aac-audio</string>
				<string>com.krowsingre.theboundvigil.mobi</string>
				<string>com.krowsingre.theboundvigil.azw</string>
				<string>com.krowsingre.theboundvigil.fb2</string>
				<string>com.krowsingre.theboundvigil.cbz</string>
				<string>com.krowsingre.theboundvigil.cbr</string>
				<string>com.krowsingre.theboundvigil.m4b</string>
				<string>com.krowsingre.theboundvigil.ogg</string>
				<string>com.krowsingre.theboundvigil.flac</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Book and audio files iOS has no name of its own for. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.mobi</string>
			<key>UTTypeDescription</key>
			<string>Mobipocket book</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mobi</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.azw</string>
			<key>UTTypeDescription</key>
			<string>Kindle book</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>azw</string>
					<string>azw3</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.fb2</string>
			<key>UTTypeDescription</key>
			<string>FictionBook</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fb2</string>
					<string>fbz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.cbz</string>
			<key>UTTypeDescription</key>
			<string>Comic book (CBZ)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.cbr</string>
			<key>UTTypeDescription</key>
			<string>Comic book (CBR)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbr</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.m4b</string>
			<key>UTTypeDescription</key>
			<string>Audiobook (M4B)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>m4b</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.ogg</string>
			<key>UTTypeDescription</key>
			<string>Ogg audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ogg</string>
					<string>oga</string>
					<string>opus</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.krowsingre.theboundvigil.flac</string>
			<key>UTTypeDescription</key>
			<string>FLAC audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>flac</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
